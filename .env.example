# =============================================================================
# server-hub secret reference
# =============================================================================
# Copy to .env and fill in real values — .env is gitignored
# This file documents every secret used across NixOS + Kubernetes layers
# =============================================================================


# =============================================================================
# SOPS / age (Kubernetes secret decryption)
# =============================================================================
# Retrieve from cluster: kubectl get secret sops-age -n flux-system -o jsonpath='{.data.age\.agekey}' | base64 -d
# Re-apply to cluster:   kubectl create secret generic sops-age -n flux-system --from-literal=age.agekey="$AGE_PRIVATE_KEY"
AGE_PRIVATE_KEY=AGE-SECRET-KEY-1...


# =============================================================================
# Tailscale
# =============================================================================
# One-time auth key — generate at https://login.tailscale.com/admin/settings/keys
# Used in: nixos/secrets/tailscale_authkey.age
TAILSCALE_AUTHKEY=tskey-auth-...


# =============================================================================
# k3s
# =============================================================================
# Any strong random string shared across all nodes
# Used in: nixos/secrets/k3s_token.age
K3S_TOKEN=your-random-k3s-token


# =============================================================================
# Google Drive (rclone)
# =============================================================================
# Full content of rclone.conf for the gdrive remote
# Used in: nixos/secrets/rclone_gdrive.age
# Generate: rclone config -> gdrive remote -> copy ~/.config/rclone/rclone.conf
RCLONE_GDRIVE_CONFIG=[gdrive]
#   type = drive
#   client_id = ...
#   client_secret = ...
#   token = {...}


# =============================================================================
# Hetzner Storage Box (SMB)
# =============================================================================
# SSH private key for rsync/SFTP access
# Used in: nixos/secrets/hetzner_ssh_key.age
HETZNER_SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----...

# SMB credentials (format used by mount.cifs)
# Used in: nixos/secrets/hza_smb_credentials.age
HZA_SMB_USERNAME=your-hetzner-smb-username
HZA_SMB_PASSWORD=your-hetzner-smb-password


# =============================================================================
# Node SSH authorized keys
# =============================================================================
# Public keys allowed to SSH into each node
# Used in: nixos/secrets/authorized_keys_systema/b/c.age
AUTHORIZED_KEYS=ssh-ed25519 AAAA... user@machine


# =============================================================================
# Cloudflare Tunnel
# =============================================================================
# Token from: https://one.dash.cloudflare.com -> Networks -> Tunnels
# Applied manually: kubectl apply -f k8s/secrets/networking-cloudflared-token.yaml
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiM...


# =============================================================================
# Kite (k8s dashboard)
# =============================================================================
# Random 64-char hex: openssl rand -hex 32
# Applied manually: kubectl apply -f k8s/secrets/kube-system-kite-secret.yaml
KITE_ENCRYPT_KEY=your-64-char-hex-key


# =============================================================================
# Gluetun VPN (WireGuard - qbittorrent-warp)
# =============================================================================
# Applied manually: kubectl apply -f k8s/secrets/media-gluetun-vpn.yaml
WIREGUARD_PRIVATE_KEY=your-wireguard-private-key
WIREGUARD_PUBLIC_KEY=your-wireguard-public-key
WIREGUARD_ENDPOINT_IP=your-vpn-server-ip
WIREGUARD_ENDPOINT_PORT=51820
WIREGUARD_ADDRESSES=10.x.x.x/32


# =============================================================================
# GHCR pull secret (private images)
# =============================================================================
# Applied manually: kubectl apply -f k8s/secrets/default-ghcr-secret.yaml
GHCR_USERNAME=RAFSuNX
GHCR_TOKEN=ghp_...


# =============================================================================
# Tools basic auth
# =============================================================================
# Applied manually: kubectl apply -f k8s/secrets/tools-tools-auth.yaml
TOOLS_AUTH_USERNAME=rafsunx
TOOLS_AUTH_PASSWORD=your-password


# =============================================================================
# SearXNG
# =============================================================================
# Random secret: openssl rand -hex 32
SEARXNG_SECRET_KEY=your-random-64-char-hex


# =============================================================================
# MinIO (Longhorn backup target)
# =============================================================================
# Used in SOPS-encrypted k8s/default/minio/01-secret.yaml
MINIO_ROOT_USER=longhorn
MINIO_ROOT_PASSWORD=your-minio-password


# =============================================================================
# Homepage API keys (SOPS-encrypted in k8s/tools/homepage/01-secret.yaml)
# =============================================================================
# Jellyfin: Settings -> API Keys
HOMEPAGE_VAR_JELLYFIN_KEY=your-jellyfin-api-key

# Sonarr: Settings -> General -> API Key
HOMEPAGE_VAR_SONARR_KEY=your-sonarr-api-key

# Radarr: Settings -> General -> API Key
HOMEPAGE_VAR_RADARR_KEY=your-radarr-api-key

# Prowlarr: Settings -> General -> API Key
HOMEPAGE_VAR_PROWLARR_KEY=your-prowlarr-api-key

# Jellyseerr: Settings -> General -> API Key
HOMEPAGE_VAR_SEERR_KEY=your-jellyseerr-api-key

# qBittorrent credentials
HOMEPAGE_VAR_QBIT_USER=your-qbit-username
HOMEPAGE_VAR_QBIT_PASS=your-qbit-password

# qBittorrent WARP credentials
HOMEPAGE_VAR_QBIT_WARP_USER=your-qbit-warp-username
HOMEPAGE_VAR_QBIT_WARP_PASS=your-qbit-warp-password
