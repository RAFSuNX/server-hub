# Copy this file to .env and fill in real values
# cp .env.example .env

# Cloudflare Tunnel token
# Get from: https://one.dash.cloudflare.com → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# SearXNG secret key (generate with: openssl rand -hex 32)
SEARXNG_SECRET_KEY=your-random-secret-here
