#!/usr/sbin/nft -f
# Standalone server - nftables firewall
# Applied by Ansible. Do not edit manually.
# Docker iptables disabled in daemon.json — forwarding managed here.

flush ruleset

table inet filter {

    chain input {
        type filter hook input priority filter; policy drop;

        iifname "lo" accept
        iifname "{{ tailscale_iface }}" accept

        ct state established,related accept
        ct state invalid drop

        tcp dport {{ ssh_port }} accept

        icmp type { echo-request, echo-reply, destination-unreachable, time-exceeded } accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        # Docker containers → internet (matches all bridge networks 172.16-31.x.x)
        ip saddr 172.16.0.0/12 accept

        # Return traffic back to any container subnet
        ip daddr 172.16.0.0/12 ct state established,related accept

        # Tailscale → container subnets and back
        iifname "{{ tailscale_iface }}" ip daddr 172.16.0.0/12 accept
        ip saddr 172.16.0.0/12 oifname "{{ tailscale_iface }}" accept
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}

table ip nat {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;

        # Masquerade all Docker bridge subnets (172.16.0.0/12 covers docker0 + custom networks)
        ip saddr 172.16.0.0/12 masquerade
    }
}
