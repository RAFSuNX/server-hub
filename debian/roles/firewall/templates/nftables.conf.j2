#!/usr/sbin/nft -f
# OciSystem - nftables firewall
# Applied by Ansible. Do not edit manually.
# k3s runs entirely over Tailscale - public interface has SSH only.

# Flush only tables we own.
# k3s manages 'ip filter', 'ip nat', 'ip mangle', 'ip6 filter', 'ip6 nat' via
# iptables-nft — those are NOT touched here. We use 'inet filter' and 'inet nat'
# which k3s never creates, so flushing them is safe and idempotent.
add table inet filter
add table inet nat
flush table inet filter
flush table inet nat

table inet filter {

    chain input {
        type filter hook input priority filter; policy drop;

        # Loopback - always allow
        iifname "lo" accept

        # Tailscale - fully trusted
        iifname "{{ tailscale_iface }}" accept

        # k8s pod network (flannel)
        iifname "flannel.1" accept
        iifname "cni0" accept

        # Internal CIDRs - k8s pod/service traffic unrestricted
        ip saddr 10.42.0.0/16 accept
        ip saddr 10.43.0.0/16 accept

        # Note: Tailscale (100.64.0.0/10) is trusted above via iifname, not
        # by CIDR - that range overlaps other CGNAT users (e.g. Cloudflare
        # WARP) and matching it by IP caused a prior outage.

        # Allow return traffic for outbound connections
        ct state established,related accept
        ct state invalid drop

        # SSH on public interface only
        tcp dport {{ ssh_port }} accept

        # ICMP - specific safe types only (no type 5 redirect)
        icmp type { echo-request, echo-reply, destination-unreachable, time-exceeded } accept
    }

    chain forward {
        type filter hook forward priority filter; policy accept;
        # k3s manages pod routing rules in this chain via iptables-nft
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}

table inet nat {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;

        # Masquerade pod/service traffic going out to internet or over tailscale
        ip saddr { 10.42.0.0/16, 10.43.0.0/16 } oifname { "{{ public_iface }}", "{{ tailscale_iface }}" } masquerade
    }
}
