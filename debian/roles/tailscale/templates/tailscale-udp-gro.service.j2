# Applied by Ansible. Do not edit manually.
# Tailscale performance best practice for exit nodes/subnet routers:
# https://tailscale.com/docs/reference/best-practices/performance

[Unit]
Description=Enable UDP GRO forwarding offload for Tailscale
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/ethtool -K {{ public_iface }} rx-udp-gro-forwarding on rx-gro-list off

[Install]
WantedBy=multi-user.target
